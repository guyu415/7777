    "emotionInteraction": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "factsCommitments": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "ongoing": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "todos": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "preferences": { "type": "string", "minLength": 1, "maxLength": 1200 }
  }
}
